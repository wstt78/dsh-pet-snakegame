{
  "name": "dsh-pet-snakegame",
  "version": "0.2.0",
  "description": "DSH 插件：鲸鱼娘桌宠贪吃蛇——Windows 透明置顶桌面小游戏，空闲变蛇追光标吃 token，工作即安静退场",
  "main": "index.mjs",
  "license": "MIT",
  "author": "whale-snake-pet contributors",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "electron",
    "desktop-pet",
    "snake-game",
    "windows",
    "overlay",
    "global-input"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron src/main.js",
    "demo": "electron src/main.js --demo",
    "test": "node --test test/",
    "check": "node scripts/release-check.mjs",
    "build:helper": "cmd /c scripts\\build-helper.cmd",
    "pack": "powershell -ExecutionPolicy Bypass -File scripts/pack.ps1"
  },
  "devDependencies": {
    "electron": "45.5.0"
  },
  "exports": {
    ".": "./index.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/DETAIL.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wstt78/dsh-pet-snakegame.git"
  },
  "homepage": "https://github.com/wstt78/dsh-pet-snakegame#readme",
  "bugs": {
    "url": "https://github.com/wstt78/dsh-pet-snakegame/issues"
  }
}
